# The calendars to sync, the event rules and your colors are saved in
# profile.json. The settings below are optional.

# Override the calendars saved in the profile.
# SOURCE_CALENDAR_NAME="Your Source Calendar Name"
# TARGET_CALENDAR_NAME="Your Target Calendar Name"

# Sync directly from an iCal feed URL instead of a Google source calendar.
# Kept out of the profile on purpose: the URL is a secret.
# Can also be passed as: unical --ical <url>
# SOURCE_ICAL_URL="https://example.com/<your-id>/<your-token>"

# Optional paths (relative paths are resolved from the current directory)
# PROFILE_PATH="profile.json"
# CREDENTIALS_PATH="credentials.json"
# TOKEN_PATH="token.json"
