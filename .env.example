# Calendar configuration
SOURCE_CALENDAR_NAME="Your Source Calendar Name"
TARGET_CALENDAR_NAME="Your Target Calendar Name"

# Optional: sync directly from an iCal feed URL instead of a
# Google source calendar. Takes precedence over SOURCE_CALENDAR_NAME.
# Can also be passed as: calendar-coloring --ical <url>
SOURCE_ICAL_URL="https://example.com/<your-id>/<your-token>"

# Optional paths (relative paths are resolved from the current directory)
# CREDENTIALS_PATH="credentials.json"
# TOKEN_PATH="token.json"
# COURSE_COLORS_PATH="course_colors.json"
# EXAM_STATES_PATH="exam_states.json"
# DEADLINE_COLORS_PATH="deadline_colors.json"
