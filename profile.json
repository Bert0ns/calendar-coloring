    },
    "rules": [
        {
            "kind": "exam",
            "field": "title",
            "match": "starts_with",
            "value": "Esame: ",
            "ignore_case": false,
            "title": "{title}"
        },
        {
            "kind": "exam",
            "field": "category",
            "match": "equals",
            "value": "Esame",
            "ignore_case": false,
            "title": "{title}"
        },
        {
            "kind": "lecture",
            "field": "title",
            "match": "starts_with",
            "value": "Lezione: Didattica - ",
            "ignore_case": false,
            "title": "{name}"
        },
        {
            "kind": "lecture",
            "field": "category",
            "match": "equals",
            "value": "Lezione",
            "ignore_case": false,
            "title": "{title}"
        },
        {
            "kind": "deadline",
            "field": "title",
            "match": "starts_with",
            "value": "Scadenza: ",
            "ignore_case": false,
            "title": "{title}"
        },
        {
            "kind": "deadline",
            "field": "category",
            "match": "equals",
            "value": "Scadenza",
            "ignore_case": false,
            "title": "{title}"
        }
    ],
    "enrollment": {
        "enrolled": {
            "field": "description",
            "match": "starts_with",
            "value": "Iscritto",
            "ignore_case": false
        },
        "not_enrolled": {
